# Contoh konfigurasi. Salin jadi .env lalu sesuaikan.
# TANPA API key. Hanya port, batas, folder.
VC_HOST=0.0.0.0
VC_PORT=8520
VC_DATA_DIR=./data
VC_DB_PATH=./data/jobs.db
VC_MAX_TEXT_CHARS=2000
VC_MAX_UPLOAD_MB=50
VC_MAX_SAMPLE_SECONDS=120
VC_SAMPLE_SECONDS=30
VC_RETENTION_HOURS=24
VC_RATE_PER_MINUTE=10
VC_QUEUE=sqlite
VC_REDIS_URL=redis://localhost:6379/0
VC_BACKEND=openvoice_piper
# Alternatif (MIT, 23 bahasa; Indonesia via 'ms'), ringan untuk RAM 8 GB:
# VC_BACKEND=chatterbox
# VC_EXAGGERATION=0.5
# VC_CFG_WEIGHT=0.5
# VC_T3_MODEL=v3
# Kemiripan suara tertinggi (Apache-2.0, Indonesia resmi, 48 kHz).
# Butuh RAM >= 16 GB (CPU) atau ~8 GB VRAM (GPU). Install: pip install voxcpm
# VC_BACKEND=voxcpm2
# VC_VOXCPM_MODEL=openbmb/VoxCPM2
# VC_VOXCPM_STEPS=10
# VC_VOXCPM_CFG=2.0
# VC_VOXCPM_SEED=42
# Isi saat endpoint dipublikasikan (header X-API-Key):
# VC_API_KEY=ganti-dengan-random-secret-panjang
VC_PIPER_VOICE=id_ID-news_tts-medium
VC_DEVICE=auto
VC_CORS_ORIGINS=
VC_VOICES_DIR=./voices
